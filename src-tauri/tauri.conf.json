{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomodoro Task",
  "version": "0.1.0",
  "identifier": "com.pomodorotask.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Enfoque — Pomodoro + Tareas",
        "width": 440,
        "height": 760,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ]
  }
}
